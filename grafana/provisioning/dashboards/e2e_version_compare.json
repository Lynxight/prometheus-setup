      "description": " Dashed line at 1s = maximum allowed cycle time."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Host RAM used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{environment=\"il-yok-hp-z2-installertest-001\"} - node_memory_MemAvailable_bytes{environment=\"il-yok-hp-z2-installertest-001\"}",
          "legendFormat": "{{environment}} used"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GPU memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED{environment=\"il-yok-hp-z2-installertest-001\"}",
          "legendFormat": "{{environment}} FB used"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GPU utilisation",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL{environment=\"il-yok-hp-z2-installertest-001\"}",
          "legendFormat": "{{environment}} GPU util"
        },
        {
          "refId": "B",
          "expr": "DCGM_FI_DEV_MEM_COPY_UTIL{environment=\"il-yok-hp-z2-installertest-001\"}",
          "legendFormat": "{{environment}} mem-copy util"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "RSS \u2014 detection",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(container_memory_rss{environment=\"il-yok-hp-z2-installertest-001\",name=~\"lynxight_detection_.*\"})",
          "legendFormat": "detection",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "RSS \u2014 ctm",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 4,
        "y": 49
      },
